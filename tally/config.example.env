# Tally form IDs — copy to config.env (gitignored) and fill in your own.
# A form ID is the token in the share URL: https://tally.so/r/<id>
#
# Name one variable per form, after the form's ROLE, not after a client or project.
# Add as many as the project needs; these two are the common source + mirror pair.

FORM_MAIN_HE=xxxxxx      # primary-language questionnaire (source of truth)
FORM_MAIN_EN=xxxxxx      # its translated mirror, if you keep one
